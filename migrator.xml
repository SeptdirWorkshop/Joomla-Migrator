<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>PLG_SYSTEM_MIGRATOR</name>
	<author>RadicalMart Team</author>
	<creationDate>July 2026</creationDate>
	<copyright>Copyright © 2026 RadicalMart. All rights reserved.</copyright>
	<license>https://www.gnu.org/copyleft/gpl.html GNU/GPL</license>
	<authorEmail>info@radicalmart.ru</authorEmail>
	<authorUrl>https://radicalmart.ru/</authorUrl>
	<version>0.0.1-dev</version>
	<description>PLG_SYSTEM_MIGRATOR_DESCRIPTION</description>
	<namespace path="src">Joomla\Plugin\System\Migrator</namespace>
	<scriptfile>script.php</scriptfile>
	<languages folder="language">
		<language tag="en-GB">en-GB/plg_system_migrator.ini</language>
		<language tag="en-GB">en-GB/plg_system_migrator.sys.ini</language>
		<language tag="ru-RU">ru-RU/plg_system_migrator.ini</language>
		<language tag="ru-RU">ru-RU/plg_system_migrator.sys.ini</language>
	</languages>
	<files>
		<folder>forms</folder>
		<folder>services</folder>
		<folder plugin="migrator">src</folder>
	</files>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field type="note" label="PLG_SYSTEM_MIGRATOR_PARAMS_DB"/>
				<field name="db_type" type="list"
					   label="PLG_SYSTEM_MIGRATOR_PARAMS_DB_TYPE"
					   default="">
					<option value="">PLG_SYSTEM_MIGRATOR_PARAMS_DB_FROM_RECIPIENT</option>
					<option value="mysql">MYSQL</option>
					<option value="mysqli">MYSQLI</option>
					<option value="pgsql">PGSQL</option>
					<option value="postgresql">POSTGRESQL</option>
				</field>
				<field name="db_host" type="text"
					   label="PLG_SYSTEM_MIGRATOR_PARAMS_DB_HOST"
					   hint="PLG_SYSTEM_MIGRATOR_PARAMS_DB_FROM_RECIPIENT"
					   default=""/>
				<field name="db_user" type="text"
					   label="PLG_SYSTEM_MIGRATOR_PARAMS_DB_USER"
					   hint="PLG_SYSTEM_MIGRATOR_PARAMS_DB_FROM_RECIPIENT"
					   default=""/>
				<field name="db_password" type="password"
					   label="PLG_SYSTEM_MIGRATOR_PARAMS_DB_PASSWORD"
					   hint="PLG_SYSTEM_MIGRATOR_PARAMS_DB_FROM_RECIPIENT"
					   default=""/>
				<field name="db_name" type="text"
					   label="PLG_SYSTEM_MIGRATOR_PARAMS_DB_NAME"
					   required="true"/>
				<field name="db_prefix" type="text"
					   label="PLG_SYSTEM_MIGRATOR_PARAMS_DB_PREFIX"
					   hint="PLG_SYSTEM_MIGRATOR_PARAMS_DB_FROM_RECIPIENT"
					   default=""/>
			</fieldset>
		</fields>
	</config>
</extension>